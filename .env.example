# Copy to .env for local testing:  cp .env.example .env
# Then:  export $(grep -v '^#' .env | xargs)   &&   python main.py
#
# On GitHub these are stored as repository secrets, not in a file.

# The spreadsheet id from your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
SHEET_ID=

# The FULL contents of the service account JSON key file, on one line.
# (Open the downloaded key file, copy everything, paste it here in quotes.)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional. Free key from https://developer.adzuna.com/  (skips Adzuna if empty)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
